---
const channels = [
  {
    name: "Apps SDK",
    routes: "mcpRoutes + @donghanh/widget",
    text: "MCP over HTTP, with iframe widgets inside ChatGPT.",
  },
  {
    name: "Self-hosted",
    routes: "chatRoutes + @donghanh/react",
    text: "Bring your own LLM and stream to a React UI over SSE.",
  },
  {
    name: "GPT Store",
    routes: "gptRoutes",
    text: "REST and OpenAPI, running inside Custom GPTs.",
    deprecated: true,
  },
];
---

<section class="section">
  <p class="section-number">02</p>
  <h2>Write it once. Reach every channel.</h2>
  <p class="section-text">
    Your operations stay the same. Pick the routes for where your users are.
  </p>
  <div class="grid">
    {
      channels.map((channel) => (
        <article class:list={["card", { "card-faded": channel.deprecated }]}>
          <h3>
            {channel.name}
            {channel.deprecated && <span class="badge">Deprecated</span>}
          </h3>
          <p>{channel.text}</p>
          <code>{channel.routes}</code>
        </article>
      ))
    }
  </div>
  <figure class="panel channel-mock">
    <figcaption>The same reply in ChatGPT, with an Apps SDK widget</figcaption>
    <div class="chat">
      <p class="chat-user">What's overdue on Q3 launch?</p>
      <p>2 of 12 cards are overdue.</p>
      <ul class="chat-list">
        <li>Book the venue</li>
        <li>Sign off the press kit</li>
      </ul>
      <span class="chat-action">Open the first overdue card</span>
    </div>
  </figure>
</section>
