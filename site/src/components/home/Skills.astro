---
import CopyCommand from "./CopyCommand.astro";

const skills = [
  {
    name: "donghanh",
    text: "Core concepts, adapters, protocol rules and common pitfalls.",
    command:
      "npx degit rezzahub/donghanh/skills/donghanh ~/.claude/skills/donghanh",
  },
  {
    name: "donghanh-prompts",
    text: "Where to put steering text in your operations.",
    command:
      "npx degit rezzahub/donghanh/skills/donghanh-prompts ~/.claude/skills/donghanh-prompts",
  },
];
---

<section class="section">
  <p class="section-number">03</p>
  <h2>Teach your coding agent.</h2>
  <p class="section-text">
    Install the skills so Claude Code, Cursor or Copilot CLI can work in a
    donghanh codebase.
  </p>
  <div class="stack">
    {
      skills.map((skill) => (
        <article class="card">
          <h3>
            <code>{skill.name}</code>
          </h3>
          <p>{skill.text}</p>
          <CopyCommand command={skill.command} />
        </article>
      ))
    }
  </div>
</section>
